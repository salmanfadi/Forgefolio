# ─── Database (Supabase) ─────────────────────────────────────────
# Supabase → Project Settings → Database → Connection string (URI).
# Use the pooled connection (port 6543) for serverless deploys.
DATABASE_URL=postgresql://postgres:[YOUR-PASSWORD]@db.[YOUR-PROJECT-REF].supabase.co:5432/postgres

# ─── Redis (Upstash or local) ────────────────────────────────────
# Upstash dashboard → Redis → REST/Connection details. Local dev via docker-compose: redis://localhost:6379
REDIS_URL=redis://localhost:6379

# ─── Encryption ──────────────────────────────────────────────────
# AES-256-GCM key for encrypting OAuth tokens at rest. Generate: openssl rand -hex 32
ENCRYPTION_KEY=

# ─── Auth.js v5 ──────────────────────────────────────────────────
# Generate: openssl rand -base64 32
AUTH_SECRET=
# Google Cloud Console → Credentials → OAuth 2.0 Client ID
AUTH_GOOGLE_ID=
AUTH_GOOGLE_SECRET=
# GitHub → Settings → Developer settings → OAuth Apps
AUTH_GITHUB_ID=
AUTH_GITHUB_SECRET=

# ─── Resend (transactional email) ────────────────────────────────
RESEND_API_KEY=
EMAIL_FROM="Forgefolio <no-reply@yourdomain.com>"

# ─── Cloudflare R2 (asset storage) ───────────────────────────────
R2_ACCOUNT_ID=
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
R2_BUCKET_NAME=

# ─── Anthropic (AI skill verification + daily tasks) ─────────────
ANTHROPIC_API_KEY=

# ─── LinkedIn OAuth (V2 — Referral Circle) ───────────────────────
LINKEDIN_CLIENT_ID=
LINKEDIN_CLIENT_SECRET=
