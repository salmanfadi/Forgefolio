# SkillPath — Environment Variables
# Copy this file to .env and fill in real values.
# NEVER commit .env — it is in .gitignore.
# This file (.env.example) IS committed — keep it up to date.

# ─── DATABASE ────────────────────────────────────────────────────────────────
# PostgreSQL connection string
# Local dev: use docker-compose.yml (postgres://skillpath:password@localhost:5432/skillpath)
# Production: Neon or Supabase — enable PgBouncer pooling
DATABASE_URL=postgresql://USER:PASSWORD@HOST:5432/skillpath

# ─── AUTH (Auth.js v5) ───────────────────────────────────────────────────────
# Generate with: openssl rand -base64 32
AUTH_SECRET=

# Google OAuth — console.cloud.google.com
# Authorised redirect URI: https://yourdomain.com/api/auth/callback/google
AUTH_GOOGLE_ID=
AUTH_GOOGLE_SECRET=

# GitHub OAuth — github.com/settings/developers
# Authorised redirect URI: https://yourdomain.com/api/auth/callback/github
AUTH_GITHUB_ID=
AUTH_GITHUB_SECRET=

# ─── AI ──────────────────────────────────────────────────────────────────────
# Anthropic — console.anthropic.com
# Used for: AI skill verification, AI Mentor chat, daily task generation
ANTHROPIC_API_KEY=

# ─── EMAIL ───────────────────────────────────────────────────────────────────
# Resend — resend.com (verify your domain first)
RESEND_API_KEY=
# Must be an address on your verified domain
EMAIL_FROM=noreply@skillpath.dev

# ─── REDIS (BullMQ job queues) ───────────────────────────────────────────────
# Local dev: redis://localhost:6379 (from docker-compose.yml)
# Production: Upstash Redis (free tier sufficient for early stage)
REDIS_URL=redis://localhost:6379

# ─── FILE STORAGE ────────────────────────────────────────────────────────────
# Cloudflare R2 (S3-compatible) — dash.cloudflare.com
# Used for: profile images, project screenshots
R2_ACCOUNT_ID=
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
R2_BUCKET_NAME=skillpath-uploads
# Public URL of your R2 bucket (set up a custom domain or use R2.dev subdomain)
R2_PUBLIC_URL=https://uploads.skillpath.dev

# ─── EXTERNAL APIs ───────────────────────────────────────────────────────────
# GitHub — for scanning public repos during skill verification (no user auth needed)
# Create a GitHub App or Personal Access Token with public_repo read scope
GITHUB_APP_TOKEN=

# LeetCode public GraphQL endpoint — no auth required
LEETCODE_API_URL=https://leetcode.com/graphql

# ─── V2 — REFERRAL CIRCLE ────────────────────────────────────────────────────
# LinkedIn OAuth — linkedin.com/developers
# Required scopes: r_basicprofile, r_emailaddress
# Authorised redirect URI: https://yourdomain.com/api/v2/professional/verify
LINKEDIN_CLIENT_ID=
LINKEDIN_CLIENT_SECRET=

# ─── SECURITY ────────────────────────────────────────────────────────────────
# AES-256 encryption key for OAuth tokens stored at rest
# Generate with: openssl rand -hex 32
# Must be exactly 32 bytes (64 hex characters)
ENCRYPTION_KEY=

# ─── APP ─────────────────────────────────────────────────────────────────────
NEXT_PUBLIC_APP_URL=http://localhost:3000
NODE_ENV=development

# ─── RATE LIMITING ───────────────────────────────────────────────────────────
# Upstash Redis (separate from BullMQ Redis in production, same for local dev)
UPSTASH_REDIS_REST_URL=
UPSTASH_REDIS_REST_TOKEN=

# ─── MONITORING (optional, add before launch) ────────────────────────────────
# Sentry — sentry.io
SENTRY_DSN=
NEXT_PUBLIC_SENTRY_DSN=
